{
  "name": "druo",
  "version": "1.0.0",
  "private": true,
  "description": "Druo — sala de cine para dos: videollamada + película sincronizada",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js & vite",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "preparar": "node scripts/preparar.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "hls.js": "^1.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
